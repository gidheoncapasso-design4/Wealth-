# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP_WEBHOOK_URL: Optional Webhook URL for automated WhatsApp dispatch services (Twilio, Z-API, Evolution API).
WHATSAPP_WEBHOOK_URL=
WHATSAPP_PROVIDER=
# GREEN-API credentials stay on the server. Use the apiUrl from its console.
WHATSAPP_GREENAPI_URL=
WHATSAPP_GREENAPI_INSTANCE=
WHATSAPP_GREENAPI_TOKEN=
WHATSAPP_ZAPI_INSTANCE=
WHATSAPP_ZAPI_TOKEN=
WHATSAPP_ZAPI_CLIENT_TOKEN=
WHATSAPP_EVOLUTION_ENDPOINT=
WHATSAPP_EVOLUTION_INSTANCE=
WHATSAPP_EVOLUTION_APIKEY=

# WHATSAPP_META_PHONE_NUMBER_ID / WHATSAPP_META_ACCESS_TOKEN: Official WhatsApp
# Cloud API (Meta for Developers / developers.facebook.com). Get the Phone
# Number ID from your app's WhatsApp > API Setup page, and the Access Token
# from the same page (the default one expires after 24h — create a "System
# User" with a permanent token under Business Settings for production use).
# While your app is still in development mode, Meta only allows sending to
# phone numbers added to the "To" recipient list on that same API Setup page.
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=

# CRON_SECRET: Shared secret required in the "x-cron-secret" header to call
# POST /api/cron/daily-reminders. Generate any long random string and put the
# same value here and in the GitHub Actions repo secret of the same name.
CRON_SECRET=

# GMAIL_USER / GMAIL_APP_PASSWORD: Used to send the "1 day before" reminder by
# e-mail via Gmail SMTP. GMAIL_APP_PASSWORD is NOT your normal Gmail password —
# enable 2-Step Verification on the Google account, then create an "App
# Password" at https://myaccount.google.com/apppasswords and paste it here.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# GOOGLE_SERVICE_ACCOUNT_KEY: The full JSON key of a Google Cloud service
# account (either the raw JSON string, or that JSON base64-encoded — both are
# accepted). Required for POST /api/cron/daily-reminders to work at all, since
# it's now used both to:
#   1) Read/write Firestore as a trusted backend (Firebase Admin SDK) — grant
#      this service account the "Cloud Datastore User" IAM role on the
#      Firebase project (needed even if you don't use Google Calendar).
#   2) Sync Google Calendar events, if GOOGLE_CALENDAR_ID below is set — also
#      enable the Calendar API on the project, and share your target Google
#      Calendar with the service account's "client_email" (Calendar Settings >
#      Share with specific people > "Make changes to events").
# GOOGLE_CALENDAR_ID: Usually your own Gmail address (acts as your primary
# calendar's ID), or a secondary calendar's ID from its settings page. Leave
# empty to skip Calendar sync (Firestore access above still applies).
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_CALENDAR_ID=
